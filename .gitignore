# AIPAM .gitignore

# Environment files (contain secrets)
.env
backend/.env

# Backend / Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
venv_unsloth/

# Databases and large state
*.db
*.sqlite
*.sqlite3
backend/aipam.db

# Logs and temp
*.log
*.tmp
*.bak
*.orig
*~

# Frontend / Node
node_modules/
frontend/node_modules/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Test cache
backend/.pytest_cache/

# Playwright reports
frontend/playwright-report/
frontend/test-results/

# Frontend build output
frontend/dist/

# Large model files and weights
trafficllm/models/
trafficllm/venv/
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt

# Training data and checkpoints (too large for git)
finetuning/aipam_gpu_training/venv/
finetuning/aipam_gpu_training/checkpoints/
finetuning/aipam_gpu_training/data/
finetuning/aipam_gpu_training/logs/
finetuning/aipam_gpu_training/aipam-llama-lora/
finetuning/aipam_gpu_training/aipam-llama-lora-v2/
finetuning/aipam_gpu_training/aipam-llama-merged/
finetuning/aipam_gpu_training/malware-traffic-indicators/
finetuning/trafficllm_datasets/
finetuning/trafficllm_training/pcaps/
finetuning/trafficllm_training/cache/
finetuning/trafficllm_training/training_data/
finetuning/trafficllm_training/*.gif

# Training ledger files (generated at runtime)
finetuning/*_ledger.jsonl
finetuning/*_ledger_host.jsonl

# PID files (runtime)
*.pid

# Duplicate/cloned TrafficLLM repos (external dependencies)
TrafficLLM/
TrafficLLM_full/
TrafficLLM_repo/

# PCAP files (can be re-downloaded)
*.pcap
*.pcapng

# Zip files
*.zip

# Benchmark outputs (generated)
benchmark_results/
benchmark_results_*/
benchmark/benchmark_results*/
benchmark/benchmark_results_*/
benchmark/pipeline_benign_results*/
benchmark/pipeline_malware_results*/

# Benchmark PCAPs (can be re-downloaded)
benchmark/benchmark_pcaps/

# Local logs / misc
frontend/nohup.out

# Unsloth caches (generated)
unsloth_compiled_cache/
finetuning/aipam_gpu_training/venv_unsloth/
finetuning/trafficllm_training/unsloth_compiled_cache/

# Fine-tuning outputs (generated)
finetuning/aipam_gpu_training/aipam-llama-lora-v*/
finetuning/aipam_gpu_training/aipam-llama-merged-v*/
finetuning/trafficllm_training/averaged_adapter/
finetuning/trafficllm_training/merged_model/
finetuning/trafficllm_training/merged_model_averaged/
finetuning/trafficllm_training/trained_models/
finetuning/trafficllm_training/training_data_batches/

# Experimental / large local datasets
zero_day_training_data/
finetuning/custom_v5_lessons.jsonl

# Root-level package-lock (real one lives in frontend/)
/package-lock.json

# Dev artifacts (local notes, not application code)
Augment_Status.md
HANDOFF.md
AIPAM_Dev_Package
AIPAM_ROM.docx
Playwright Testing Bootstrap.md

# Test fixture exceptions (small generated PCAPs for CI)
!frontend/tests/fixtures/dummy.pcap
!tests/fixtures/golden/*.pcap

# PDF papers
*.pdf

# DAWN framework (external repo)
DAWN/
aipam-migrate-20260304/
aipam-migrate-20260305/
