{
  "name": "aipam-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_AIPAM_DEMO_MODE=true vite",
    "build": "vite build",
    "build:demo": "VITE_AIPAM_DEMO_MODE=true vite build --base=/AIPAMDEMO2/",
    "build:demo:nhan": "VITE_AIPAM_DEMO_MODE=true vite build --base=/AIPAM_DEMO/",
    "build:demo:pages": "npm run build:demo && cp dist/index.html dist/404.html",
    "build:demo:pages:nhan": "npm run build:demo:nhan && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "preview:demo": "vite preview --host",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
