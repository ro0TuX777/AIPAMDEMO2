# AIPAM Backend Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# LLM Configuration
# =============================================================================

# LLM Provider: "ollama" (local) or "openai" (cloud)
LLM_PROVIDER=ollama

# For Ollama (local/air-gapped)
LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
LLM_MODEL_NAME=aipam-traffic-llm

# For OpenAI (cloud)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-api-key-here
# LLM_MODEL_NAME=gpt-4

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=600

# =============================================================================
# Storage Paths
# =============================================================================

FILE_STORAGE_PATH=/tmp/aipam_storage
REPORTS_PATH=/tmp/aipam_storage/reports

# =============================================================================
# RAG / Vector Store Configuration
# =============================================================================

# Embedding model (downloads automatically if not present)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# For air-gapped: path to local embedding model
# EMBEDDING_MODEL_PATH=/path/to/local/model

# ChromaDB storage location
VECTOR_STORE_PATH=./chroma_data

# =============================================================================
# Database
# =============================================================================

DATABASE_URL=sqlite:///./aipam.db

# =============================================================================
# Celery (Background Tasks)
# =============================================================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

