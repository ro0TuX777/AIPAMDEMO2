{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipam.local/schemas/bluescrub/raw-finding/1",
  "title": "BlueScrub raw normalized finding",
  "description": "Output of an adapter. Carries no scoring decisions. See docs/BLUESCRUB_DATA_CONTRACTS.md §1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sensor", "sensor_version", "rule_id", "issue_family", "confidence", "location"
  ],
  "properties": {
    "schema": { "const": "bluescrub.raw/1" },

    "sensor": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sensor_version": { "type": "string", "maxLength": 64 },
    "ruleset_version": { "type": ["string", "null"], "maxLength": 128 },
    "rule_namespace": { "type": ["string", "null"], "maxLength": 128 },
    "rule_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "rule_version": { "type": ["string", "null"], "maxLength": 32 },
    "detector_class": {
      "description": "Authority class used by severity precedence (tier 3).",
      "enum": ["semantic_dataflow", "taint", "ast_pattern", "regex_pattern", "heuristic"]
    },

    "raw_severity": {
      "description": "Verbatim scanner severity, retained for audit. Never used for scoring.",
      "type": ["string", "null"], "maxLength": 32
    },

    "issue_family": {
      "description": "Closed vocabulary. 'unmapped' is persisted and displayed but never scored.",
      "enum": [
        "memory-safety", "command-injection", "path-traversal", "deserialization", "ssrf", "xxe",
        "sql-injection", "weak-crypto", "insecure-random", "hardcoded-secret", "credential-exposure",
        "authz-bypass", "unauth-control-channel", "hardcoded-c2", "kill-switch",
        "dependency-vulnerable", "dependency-confusion", "typosquat",
        "attribution-marking", "attribution-identity", "attribution-infrastructure",
        "build-path-leak", "metadata-leak", "forensic-artifact",
        "signature-trivial", "signature-known", "anti-analysis", "obfuscation-weak",
        "shellcode-pattern", "packer-detected", "symbol-exposure", "string-exposure",
        "import-exposure", "decompile-easy",
        "iac-misconfig", "ci-misconfig", "container-misconfig",
        "unmapped"
      ]
    },
    "pillar_hint": {
      "description": "Rule-level, never tool-level. Null for unmapped rules.",
      "enum": ["Detectability", "Attribution", "Co-Optability", "Vulnerability", "RE-Feasibility", null]
    },
    "source_facet": {
      "enum": ["source", "binary", "vulnerability", "iac", "hardening", "yara"]
    },

    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["source", "binary", "project"] },
        "file": { "type": ["string", "null"], "maxLength": 1024 },
        "start_line": { "type": ["integer", "null"], "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 },
        "start_column": { "type": ["integer", "null"], "minimum": 0 },
        "end_column": { "type": ["integer", "null"], "minimum": 0 },
        "symbol": { "type": ["string", "null"], "maxLength": 256 },
        "node_kind": { "type": ["string", "null"], "maxLength": 64 },
        "artifact_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "format": { "type": ["string", "null"], "maxLength": 32 },
        "architecture": { "type": ["string", "null"], "maxLength": 32 },
        "section": { "type": ["string", "null"], "maxLength": 64 },
        "offset": { "type": ["integer", "null"], "minimum": 0 },
        "function_fingerprint": { "type": ["string", "null"], "maxLength": 64 },
        "subject": {
          "description": "Project-scoped findings: package@version, commit sha, or config path.",
          "type": ["string", "null"], "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "source" } } },
          "then": { "required": ["file", "start_line", "start_column"] }
        },
        {
          "if": { "properties": { "kind": { "const": "binary" } } },
          "then": { "required": ["artifact_sha256"] }
        },
        {
          "if": { "properties": { "kind": { "const": "project" } } },
          "then": { "required": ["subject"] }
        }
      ]
    },

    "matched_tokens": { "type": ["string", "null"], "maxLength": 4096 },
    "context_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },

    "title": { "type": ["string", "null"], "maxLength": 512 },
    "description": { "type": ["string", "null"], "maxLength": 4096 },
    "recommendation": { "type": ["string", "null"], "maxLength": 2048 },
    "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-[0-9]+$" }, "default": [] },
    "mitre": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
          "name": { "type": ["string", "null"], "maxLength": 128 },
          "tactic": { "type": ["string", "null"], "maxLength": 64 }
        }
      }
    },

    "observables": {
      "description": "Typed observables for the IOC bridge. See plan §7.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value", "origin"],
        "properties": {
          "type": {
            "description": "Existing IocType values plus the two additions with defined equality.",
            "enum": ["ip", "domain", "url", "hash", "ja3", "ja3s", "sni", "email", "mutex",
                     "registry", "cert_fingerprint", "service_name"]
          },
          "value": { "type": "string", "maxLength": 2048 },
          "normalized": { "type": ["string", "null"], "maxLength": 2048 },
          "origin": { "enum": ["source_literal", "recovered_string", "manifest", "git_metadata",
                               "binary_import", "config_blob"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },

    "typed_evidence": {
      "description": "Correlation-relevant but without defined equality semantics yet: PDB/build paths, YARA families, API sequences, import sequences. Not IOCs. See plan §7.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["pdb_path", "build_path", "yara_family", "api_sequence",
                             "import_sequence", "function_fingerprint"] },
          "value": { "type": "string", "maxLength": 4096 }
        }
      }
    },

    "secret": {
      "description": "Populated by secret scanners. The plaintext is NEVER carried here.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["secret_type", "masked_value", "fingerprint"],
      "properties": {
        "secret_type": { "type": "string", "maxLength": 64 },
        "masked_value": { "type": "string", "maxLength": 64 },
        "fingerprint": { "type": "string", "pattern": "^hmac-sha256:[a-f0-9]{64}$" }
      }
    },

    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "fp_filters_applied": {
      "type": "array", "default": [],
      "items": { "type": "string", "maxLength": 64 }
    },
    "truncated": { "type": "boolean", "default": false }
  }
}
