{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipam.local/schemas/bluescrub/evidence-envelope/2",
  "title": "BlueScrub evidence envelope",
  "description": "The JSON stored in Finding.evidence_json. Size-capped; anything clipped sets truncated=true. All string content is rendered inert. See docs/BLUESCRUB_DATA_CONTRACTS.md and docs/BLUESCRUB_LLM_BOUNDARY.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "fingerprint_scheme", "scoring_model", "pillar", "issue_family",
    "primary_sensor", "rule_id", "severity_source", "location"
  ],
  "properties": {
    "schema": { "const": "bluescrub/2" },
    "fingerprint_scheme": { "const": "fp/2" },
    "scoring_model": { "type": "string", "pattern": "^dacvr/[0-9]+\\.[0-9]+$" },
    "canonicalization_version": { "type": "string", "pattern": "^canon/[0-9]+$" },

    "pillar": {
      "enum": ["Detectability", "Attribution", "Co-Optability", "Vulnerability", "RE-Feasibility"]
    },
    "related_pillars": {
      "type": "array", "default": [],
      "items": {
        "enum": ["Detectability", "Attribution", "Co-Optability", "Vulnerability", "RE-Feasibility"]
      }
    },
    "source": { "enum": ["source", "binary", "vulnerability", "iac", "hardening", "yara"] },
    "issue_family": { "type": "string", "maxLength": 64 },
    "scored": { "type": "boolean", "default": true },

    "primary_sensor": { "type": "string", "maxLength": 64 },
    "sensor_version": { "type": ["string", "null"], "maxLength": 64 },
    "ruleset_version": { "type": ["string", "null"], "maxLength": 128 },
    "ruleset_state": { "enum": ["current", "rules_stale", "database_stale", "unknown", null] },
    "rule_id": { "type": "string", "maxLength": 256 },
    "rule_version": { "type": ["string", "null"], "maxLength": 32 },
    "detector_class": {
      "enum": ["semantic_dataflow", "taint", "ast_pattern", "regex_pattern", "heuristic", null]
    },

    "corroborating_sensors": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sensor", "rule_id"],
        "properties": {
          "sensor": { "type": "string", "maxLength": 64 },
          "rule_id": { "type": "string", "maxLength": 256 },
          "detector_class": {
            "enum": ["semantic_dataflow", "taint", "ast_pattern", "regex_pattern", "heuristic", null]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },

    "location": { "$ref": "raw-finding.schema.json#/properties/location" },

    "code": {
      "description": "Capped at 4 KiB. Rendered inert — never as HTML, SVG, or script.",
      "type": ["string", "null"],
      "maxLength": 4096
    },
    "occurrence_index": { "type": "integer", "minimum": 0, "default": 0 },

    "cwe": { "type": "array", "default": [], "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } },
    "mitre": { "$ref": "raw-finding.schema.json#/properties/mitre" },

    "severity_source": {
      "enum": ["rule_mapping", "impact_modifier", "precedence", "fallback"]
    },
    "severity_rationale": {
      "description": "Deterministic, produced by the scoring engine. Never merged with LLM interpretation.",
      "type": ["string", "null"],
      "maxLength": 2048
    },
    "recommendation": { "type": ["string", "null"], "maxLength": 2048 },

    "auto_fix": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "patch": {
          "description": "Inline only when small. Larger patches go to report/fixes/ and are referenced by digest.",
          "type": ["string", "null"],
          "maxLength": 8192
        },
        "patch_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "patch_ref": { "type": ["string", "null"], "maxLength": 512 }
      }
    },

    "fp_filters_applied": { "type": "array", "default": [], "items": { "type": "string", "maxLength": 64 } },
    "observables": { "$ref": "raw-finding.schema.json#/properties/observables" },
    "typed_evidence": { "$ref": "raw-finding.schema.json#/properties/typed_evidence" },
    "secret": { "$ref": "raw-finding.schema.json#/properties/secret" },

    "re_signal": {
      "description": "RE-Feasibility findings only.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["signal", "normalized", "weight"],
      "properties": {
        "signal": {
          "enum": ["symbols", "packing", "string_yield", "anti_analysis", "decompilation",
                   "runtime_language", "import_table", "config_exposure"]
        },
        "raw": { "type": ["string", "number", "null"] },
        "normalized": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "artifact_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },

    "artifact": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "filename": { "type": ["string", "null"], "maxLength": 512 },
        "format": { "type": ["string", "null"], "maxLength": 32 },
        "offset": { "type": ["integer", "null"], "minimum": 0 },
        "offset_bucket": { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "triage_carry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["match"],
      "properties": {
        "origin_job_id": { "type": ["string", "null"] },
        "match": { "enum": ["exact", "semantic", "ambiguous", null] },
        "prior_rule_version": { "type": ["string", "null"], "maxLength": 32 },
        "current_rule_version": { "type": ["string", "null"], "maxLength": 32 },
        "requires_review": { "type": "boolean", "default": false }
      }
    },

    "capped_by": { "enum": ["rule_cap", "family_cap", "info_cap", null], "default": null },
    "truncated": { "type": "boolean", "default": false }
  }
}
