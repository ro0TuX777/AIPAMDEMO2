# AIPAM V2 — Environment Configuration
# Copy to .env and edit before deploying:
#   cp .env.example .env

# ============================================
# REQUIRED
# ============================================

# API authentication token (any string — shared between frontend and backend)
AIPAM_API_TOKEN=changeme-generate-a-secure-token

# ============================================
# OPTIONAL (defaults shown)
# ============================================

# LLM model name (override to use a different Ollama model)
# LLM_MODEL_NAME=aipam-trafficllm-v10

# Concurrency
# AIPAM_MAX_CONCURRENT_JOBS=1
# AIPAM_SENSOR_PARALLELISM=1

# Disk guardrails
# AIPAM_MAX_JOB_DISK_BYTES=53687091200       # 50 GB per job
# AIPAM_MAX_EXTRACTED_BYTES=10737418240       # 10 GB extracted files per job
# AIPAM_PREFLIGHT_MULTIPLIER=4                # free space must be 4× PCAP size

# Retention
# AIPAM_JOB_RETENTION_DAYS=30
# AIPAM_LOG_RETENTION_DAYS=30
# AIPAM_LOG_MAX_MB=500

# Disk monitoring thresholds (percentage)
# AIPAM_DISK_WARN_PCT=80
# AIPAM_DISK_CRITICAL_PCT=95

# Service URLs (set by docker-compose; override only for custom setups)
# AIPAM_OLLAMA_URL=http://ollama:11434
# AIPAM_REDIS_URL=redis://redis:6379/0

# AIPAM-owned MNEMOS forensic memory.  The AIPAM containers always use Docker
# DNS (http://mnemos-service:8700); host operators use http://localhost:1888.
# Set false to keep reads and writes on the existing local ChromaDB store.
# MNEMOS_ENABLED=true
# MNEMOS_TOKEN=change-this-for-authenticated-mnemos
# MNEMOS_POSTGRES_PASSWORD=change-this-for-mnemos-postgres
# MNEMOS_GPU_DEVICE=cpu

# ============================================
# ARKIME (optional — enable with: docker compose --profile arkime up)
# ============================================

# Master toggle — set to true when running the arkime Compose profile
# ARKIME_ENABLED=false

# Internal URL for backend → Arkime API communication (Docker DNS)
# ARKIME_API_URL=http://arkime-viewer:8005

# Public URL for analyst browser links (adjust host/port as needed)
# ARKIME_PUBLIC_URL=http://localhost:8005

# Arkime viewer credentials (set during arkime-init bootstrap)
# ARKIME_API_USERNAME=admin
# ARKIME_API_PASSWORD=changeme

# OpenSearch URL (internal Docker DNS)
# ARKIME_OPENSEARCH_URL=http://opensearch:9200

# Node name for Arkime capture/import processes
# ARKIME_NODE_NAME=aipam-node

# Enable/disable PCAP import from AIPAM jobs into Arkime
# ARKIME_IMPORT_ENABLED=true

# Auto-import PCAPs on job completion (false = manual import only)
# ARKIME_AUTO_IMPORT=false

# Arkime viewer port on host (default 8005)
# ARKIME_VIEWER_PORT=8005

# Arkime admin password for init bootstrap
# ARKIME_ADMIN_PASSWORD=changeme

# Docker image for Arkime services
# ARKIME_IMAGE=ghcr.io/arkime/arkime/arkime:v6-latest
